    }, {
      "id": "eb8de8c9-2274-4b00-8170-d91851fe3b34",
      "comment": "",
      "command": "executeScript",
      "target": "(function continuouslyScrollAndClick() {     const clickClipButtons = () => {         document.querySelectorAll('button').forEach(button => {             if (button.textContent.trim() === 'Clip') {                 button.click();             }         });     };      clickClipButtons();     window.scrollBy(0, window.innerHeight * 0.75);     setTimeout(continuouslyScrollAndClick, 1400); })();",
      "targets": [],
      "value": ""
    }]
